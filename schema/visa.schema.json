{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "visa.schema.json",
  "$comment": "Copyright (c) 2026 Zayier Xie. All rights reserved.",
  "title": "Visa guidance for one destination regime (data/visa/<id>.yml), for one passport type",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name_zh",
    "passport",
    "last_checked",
    "requirement"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name_zh": {
      "type": "string",
      "minLength": 1
    },
    "passport": {
      "enum": [
        "cn_ordinary"
      ],
      "description": "这份指引适用的护照；用户选了别的护照，只显示链接"
    },
    "last_checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "visa_zh",
        "conf",
        "src"
      ],
      "properties": {
        "answer": {
          "enum": [
            "required",
            "visa_free",
            "not_needed"
          ]
        },
        "visa_zh": {
          "type": "string",
          "minLength": 1
        },
        "short_zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "description": "会议页地点块上的短标签，默认按 answer 写（需要签证 / 免签）；不是签证的证件写它自己的名字（港澳通行证）"
        },
        "conditions_zh": {
          "type": "string"
        },
        "until": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "conf": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "src": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "minLength": 2
        },
        "json_path": {
          "type": "string"
        },
        "json_value": {
          "type": "string"
        },
        "anchor": {
          "type": "string",
          "minLength": 2
        },
        "note_zh": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "quote"
              ]
            },
            {
              "required": [
                "json_path",
                "json_value"
              ]
            }
          ]
        }
      ]
    },
    "apply": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/link"
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "amount",
              "currency",
              "src"
            ],
            "properties": {
              "item": {
                "type": "string",
                "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "src": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 2
              },
              "json_path": {
                "type": "string"
              },
              "json_value": {
                "type": "string"
              },
              "anchor": {
                "type": "string",
                "minLength": 2
              },
              "note_zh": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "quote"
                    ]
                  },
                  {
                    "required": [
                      "json_path",
                      "json_value"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "status",
              "note_zh"
            ],
            "properties": {
              "item": {
                "type": "string",
                "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
              },
              "status": {
                "const": "unverified"
              },
              "note_zh": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "earliest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "unit",
            "src"
          ],
          "properties": {
            "n": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "enum": [
                "day",
                "workday",
                "week",
                "month"
              ]
            },
            "src": {
              "type": "string"
            },
            "quote": {
              "type": "string",
              "minLength": 2
            },
            "json_path": {
              "type": "string"
            },
            "json_value": {
              "type": "string"
            },
            "anchor": {
              "type": "string",
              "minLength": 2
            },
            "note_zh": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "quote"
                  ]
                },
                {
                  "required": [
                    "json_path",
                    "json_value"
                  ]
                }
              ]
            }
          ]
        },
        "latest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "unit",
            "src"
          ],
          "properties": {
            "n": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "enum": [
                "day",
                "workday",
                "week",
                "month"
              ]
            },
            "src": {
              "type": "string"
            },
            "quote": {
              "type": "string",
              "minLength": 2
            },
            "json_path": {
              "type": "string"
            },
            "json_value": {
              "type": "string"
            },
            "anchor": {
              "type": "string",
              "minLength": 2
            },
            "note_zh": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "quote"
                  ]
                },
                {
                  "required": [
                    "json_path",
                    "json_value"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label_zh",
              "text_zh",
              "src"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
              },
              "label_zh": {
                "type": "string",
                "minLength": 1
              },
              "text_zh": {
                "type": "string",
                "minLength": 1
              },
              "src": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 2
              },
              "json_path": {
                "type": "string"
              },
              "json_value": {
                "type": "string"
              },
              "anchor": {
                "type": "string",
                "minLength": 2
              },
              "note_zh": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "quote"
                    ]
                  },
                  {
                    "required": [
                      "json_path",
                      "json_value"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label_zh",
              "status",
              "note_zh"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
              },
              "label_zh": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "tba",
                  "unverified"
                ]
              },
              "note_zh": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "lead": {
      "oneOf": [
        {
          "$ref": "#/definitions/processingTime"
        },
        {
          "$ref": "#/definitions/appointmentWait"
        },
        {
          "$ref": "#/definitions/unknown"
        }
      ]
    },
    "documents": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_zh",
              "src"
            ],
            "properties": {
              "item_zh": {
                "type": "string",
                "minLength": 1
              },
              "src": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 2
              },
              "json_path": {
                "type": "string"
              },
              "json_value": {
                "type": "string"
              },
              "anchor": {
                "type": "string",
                "minLength": 2
              },
              "note_zh": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "quote"
                    ]
                  },
                  {
                    "required": [
                      "json_path",
                      "json_value"
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "$ref": "#/definitions/unknown"
        }
      ]
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text_zh",
          "src"
        ],
        "properties": {
          "text_zh": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "src": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 2
          },
          "json_path": {
            "type": "string"
          },
          "json_value": {
            "type": "string"
          },
          "anchor": {
            "type": "string",
            "minLength": 2
          },
          "note_zh": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "quote"
                ]
              },
              {
                "required": [
                  "json_path",
                  "json_value"
                ]
              }
            ]
          }
        ]
      }
    },
    "transit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_zh",
          "src"
        ],
        "properties": {
          "item_zh": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 2
          },
          "json_path": {
            "type": "string"
          },
          "json_value": {
            "type": "string"
          },
          "anchor": {
            "type": "string",
            "minLength": 2
          },
          "note_zh": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "quote"
                ]
              },
              {
                "required": [
                  "json_path",
                  "json_value"
                ]
              }
            ]
          }
        ]
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/link"
      }
    },
    "note_zh": {
      "type": "string"
    }
  },
  "definitions": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_zh",
        "url"
      ],
      "properties": {
        "label_zh": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "asOf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "src"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "src": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "minLength": 2
        },
        "json_path": {
          "type": "string"
        },
        "json_value": {
          "type": "string"
        },
        "anchor": {
          "type": "string",
          "minLength": 2
        },
        "note_zh": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "quote"
              ]
            },
            {
              "required": [
                "json_path",
                "json_value"
              ]
            }
          ]
        }
      ]
    },
    "what": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what",
        "src"
      ],
      "properties": {
        "what": {
          "type": "string",
          "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
        },
        "src": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "minLength": 2
        },
        "json_path": {
          "type": "string"
        },
        "json_value": {
          "type": "string"
        },
        "anchor": {
          "type": "string",
          "minLength": 2
        },
        "note_zh": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "quote"
              ]
            },
            {
              "required": [
                "json_path",
                "json_value"
              ]
            }
          ]
        }
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note_zh"
      ],
      "properties": {
        "status": {
          "enum": [
            "tba",
            "unverified"
          ]
        },
        "note_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "processingTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "official",
        "as_of",
        "app_buffer"
      ],
      "properties": {
        "kind": {
          "const": "processing_time"
        },
        "official": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "src"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "enum": [
                "day",
                "workday",
                "week",
                "month"
              ]
            },
            "max": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "src": {
              "type": "string"
            },
            "quote": {
              "type": "string",
              "minLength": 2
            },
            "json_path": {
              "type": "string"
            },
            "json_value": {
              "type": "string"
            },
            "anchor": {
              "type": "string",
              "minLength": 2
            },
            "note_zh": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "quote"
                  ]
                },
                {
                  "required": [
                    "json_path",
                    "json_value"
                  ]
                }
              ]
            }
          ]
        },
        "as_of": {
          "$ref": "#/definitions/asOf"
        },
        "includes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/what"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/what"
          }
        },
        "caveat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "src"
          ],
          "properties": {
            "src": {
              "type": "string"
            },
            "quote": {
              "type": "string",
              "minLength": 2
            },
            "json_path": {
              "type": "string"
            },
            "json_value": {
              "type": "string"
            },
            "anchor": {
              "type": "string",
              "minLength": 2
            },
            "note_zh": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "quote"
                  ]
                },
                {
                  "required": [
                    "json_path",
                    "json_value"
                  ]
                }
              ]
            }
          ]
        },
        "app_buffer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "weeks",
            "basis"
          ],
          "description": "本应用自己的缓冲，不是官方数字",
          "properties": {
            "weeks": {
              "type": "number",
              "minimum": 0
            },
            "basis": {
              "const": "assumption"
            },
            "note_zh": {
              "type": "string"
            }
          }
        }
      }
    },
    "appointmentWait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "as_of",
        "posts"
      ],
      "properties": {
        "kind": {
          "const": "appointment_wait"
        },
        "as_of": {
          "$ref": "#/definitions/asOf"
        },
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "src"
          ],
          "properties": {
            "src": {
              "type": "string"
            },
            "quote": {
              "type": "string",
              "minLength": 2
            },
            "json_path": {
              "type": "string"
            },
            "json_value": {
              "type": "string"
            },
            "anchor": {
              "type": "string",
              "minLength": 2
            },
            "note_zh": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "quote"
                  ]
                },
                {
                  "required": [
                    "json_path",
                    "json_value"
                  ]
                }
              ]
            }
          ]
        },
        "posts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name_zh",
              "months"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
              },
              "name_zh": {
                "type": "string",
                "minLength": 1
              },
              "months": {
                "type": "number",
                "minimum": 0
              },
              "qualifier": {
                "enum": [
                  "lt"
                ]
              },
              "avg_months": {
                "type": "number",
                "minimum": 0
              },
              "src": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "minLength": 2
              },
              "json_path": {
                "type": "string"
              },
              "json_value": {
                "type": "string"
              },
              "anchor": {
                "type": "string",
                "minLength": 2
              },
              "note_zh": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "quote"
                    ]
                  },
                  {
                    "required": [
                      "json_path",
                      "json_value"
                    ]
                  }
                ]
              }
            ]
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/what"
          }
        }
      }
    }
  }
}
