{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "china-holidays.schema.json",
  "$comment": "Copyright (c) 2026 Zayier Xie. SPDX-License-Identifier: AGPL-3.0-or-later",
  "title": "Chinese public holidays and 调休 working days for one year (data/china/holidays-<year>.yml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "year",
    "status",
    "holidays",
    "workdays",
    "last_checked"
  ],
  "properties": {
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "status": {
      "enum": [
        "confirmed",
        "estimated"
      ]
    },
    "basis": {
      "const": "assumption"
    },
    "src": {
      "type": "string"
    },
    "notice_zh": {
      "type": "string"
    },
    "method_zh": {
      "type": "string"
    },
    "holidays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_zh",
          "start",
          "end"
        ],
        "properties": {
          "name_zh": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "statutory": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "src"
              ],
              "properties": {
                "src": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 2
                },
                "json_path": {
                  "type": "string"
                },
                "json_value": {
                  "type": "string"
                },
                "anchor": {
                  "type": "string",
                  "minLength": 2
                },
                "note_zh": {
                  "type": "string"
                }
              },
              "allOf": [
                {
                  "anyOf": [
                    {
                      "required": [
                        "quote"
                      ]
                    },
                    {
                      "required": [
                        "json_path",
                        "json_value"
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "src": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 2
          },
          "json_path": {
            "type": "string"
          },
          "json_value": {
            "type": "string"
          },
          "anchor": {
            "type": "string",
            "minLength": 2
          },
          "note_zh": {
            "type": "string"
          }
        }
      }
    },
    "workdays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "name_zh"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "name_zh": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 2
          },
          "json_path": {
            "type": "string"
          },
          "json_value": {
            "type": "string"
          },
          "anchor": {
            "type": "string",
            "minLength": 2
          },
          "note_zh": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "quote"
                ]
              },
              {
                "required": [
                  "json_path",
                  "json_value"
                ]
              }
            ]
          }
        ]
      }
    },
    "last_checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "note_zh": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        }
      },
      "then": {
        "required": [
          "src"
        ],
        "properties": {
          "holidays": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "quote"
              ]
            }
          }
        }
      },
      "else": {
        "required": [
          "basis",
          "method_zh"
        ],
        "properties": {
          "holidays": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "statutory",
                "evidence"
              ]
            }
          }
        }
      }
    }
  ]
}
