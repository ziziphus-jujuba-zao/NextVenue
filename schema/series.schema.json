{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "series.schema.json",
  "$comment": "Copyright (c) 2026 Zayier Xie. All rights reserved.",
  "title": "One venue series (data/series/<id>.yml): names, directions, periodicity and links to dblp and ccfddl",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "acronym", "directions", "data_level"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "acronym": { "type": "string", "minLength": 1, "description": "会议现在的写法：NeurIPS、HSCC+ICCPS" },
    "full_name": { "type": "string", "minLength": 3 },
    "name_zh": { "type": "string", "minLength": 2 },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "以前或别处用过的缩写和全称（HSCC、USENIX ATC）；等级匹配会读"
    },
    "directions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]+/[a-z0-9-]+$" },
      "description": "data/taxonomy.yml 里的方向 id，主方向在前"
    },
    "periodicity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle", "basis"],
      "properties": {
        "cycle": { "enum": ["annual", "twice_yearly", "biennial", "triennial", "quadrennial", "irregular"] },
        "parity": { "enum": ["even", "odd"], "description": "两年一届的会在偶数年还是奇数年" },
        "since": { "type": "integer", "minimum": 1900, "maximum": 2100, "description": "从这一年起按这个周期" },
        "basis": { "enum": ["official", "observed"], "description": "official：官网写明（要 src + quote）；observed：按往届举办年份看出来的（要 note_zh）" },
        "src": { "type": "string" },
        "quote": { "type": "string", "minLength": 2 },
        "note_zh": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "basis": { "const": "official" } } }, "then": { "required": ["src", "quote"] } },
        { "if": { "properties": { "basis": { "const": "observed" } } }, "then": { "required": ["note_zh"] } },
        { "if": { "required": ["parity"] }, "then": { "properties": { "cycle": { "const": "biennial" } } } }
      ]
    },
    "dblp": { "type": "string", "pattern": "^(conf|journals)/[a-z0-9_.-]+$" },
    "ccfddl": { "type": "string", "pattern": "^[A-Z]{2}/.+$", "description": "ccfddl 系列键 <sub>/<title>；导入脚本只通过它把上游届次挂到这个系列" },
    "data_level": { "enum": ["curated", "upstream"] },
    "note_zh": { "type": "string" }
  }
}
