{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rank-list.schema.json",
  "$comment": "Copyright (c) 2026 Zayier Xie. SPDX-License-Identifier: AGPL-3.0-or-later",
  "title": "One official recommendation list of conferences (data/ranks/<list>.yml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label_zh", "name_zh", "issuer_zh", "kind", "edition", "edition_zh", "released", "official_url", "tiers", "attach", "license", "categories", "verified", "entries"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+[0-9]*$" },
    "label_zh": { "type": "string", "minLength": 1, "description": "标签前缀：CCF、CAA、CAAI、科协" },
    "name_zh": { "type": "string" },
    "name_en": { "type": "string" },
    "issuer_zh": { "type": "string" },
    "issuer_en": { "type": "string" },
    "kind": { "enum": ["society", "government", "university", "international"], "description": "学会 | 政府机构 | 学校（必须标明是学校目录）| 国际" },
    "edition": { "type": "string" },
    "edition_zh": { "type": "string" },
    "released": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note_zh": { "type": "string" },
    "official_url": { "type": "string", "pattern": "^https?://" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pages": { "type": "integer", "minimum": 1 },
        "retrieved_via": { "type": "string" },
        "note_zh": { "type": "string" }
      }
    },
    "tiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "tier_meaning_zh": { "type": "object", "additionalProperties": { "type": "string" } },
    "attach": { "enum": ["series", "edition"], "description": "series：标签属于整个系列；edition：只属于 covers_year 那一届（科协）" },
    "covers_year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "note_zh"],
      "properties": {
        "display": { "const": "tier_and_citation", "description": "界面只显示等级 + 目录名、版次和官方链接，不转载目录本身" },
        "note_zh": { "type": "string" },
        "site_notice": { "type": "string", "description": "发布方网站关于转载的原话（CAA：版权所有 不得转载）" }
      }
    },
    "disclaimer_zh": { "type": "string" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_zh"],
        "properties": {
          "id": { "type": "string" },
          "name_zh": { "type": "string" },
          "name_en": { "type": "string" },
          "code": { "type": "string" }
        }
      }
    },
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "method_zh"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "method_zh": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "by_tier": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "acronym", "full_name", "tier", "category", "match_keys"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "acronym": { "type": ["string", "null"] },
          "full_name": { "type": "string", "minLength": 1 },
          "name_zh": { "type": "string" },
          "tier": { "type": "string" },
          "category": { "type": "string" },
          "scope": { "enum": ["international", "domestic"] },
          "page": { "type": "integer", "minimum": 1 },
          "society_zh": { "type": "string" },
          "note": { "type": "string" },
          "match_keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(acronym|name|dblp):.+$" } }
        }
      }
    }
  }
}
