{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "source-file.schema.json",
  "$comment": "Copyright (c) 2026 Zayier Xie. SPDX-License-Identifier: AGPL-3.0-or-later",
  "title": "Official sources for one edition (managed by `pnpm snapshot`)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edition",
    "sources"
  ],
  "properties": {
    "edition": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "title",
          "kind",
          "fetched_at",
          "http_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "mirror_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "description": "官方原址拒绝抓取（如 403）时，同一机构的镜像地址；快照从这里抓"
          },
          "embedded": {
            "type": "boolean",
            "description": "页面正文由 JavaScript 从页面自带的数据画出（Nuxt、Next，如 esmo.org）；快照另外收这份数据里的文字（snapshot add --embedded）"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "kind": {
            "enum": [
              "cfp",
              "author_guide",
              "dates",
              "faq",
              "policy",
              "blog",
              "form",
              "repo",
              "other"
            ]
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "http_status": {
            "type": "integer"
          },
          "snapshot": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "note_zh": {
            "type": "string"
          }
        }
      }
    }
  }
}
